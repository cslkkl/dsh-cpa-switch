{
  "name": "dsh-cpa-switch",
  "version": "0.3.0",
  "type": "module",
  "description": "DeepSeek Harness 插件：在 DSH 里管理 CLIProxyAPI 的账号 —— 余额、签到、任务、切换账号，并让 CPA 随 DSH 启停。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cliproxyapi",
    "cpa",
    "plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cslkkl/dsh-cpa-switch.git"
  },
  "icon": "./icon.svg",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README_en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\"",
    "test": "vitest run",
    "verify:artifacts": "node scripts/verify-artifacts.cjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm verify:artifacts && pnpm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.7-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.7-rc.2",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
