{
  "name": "dsh-cpa-switch",
  "version": "0.23.0",
  "type": "module",
  "description": "DeepSeek Harness 插件：在 DSH 里管理 CLIProxyAPI 的账号 —— 余额、签到、任务、切换账号，并让 CPA 随 DSH 启停。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cliproxyapi",
    "cpa",
    "plugin"
  ],
  "author": "cslkkl",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cslkkl/dsh-cpa-switch.git"
  },
  "bugs": {
    "url": "https://github.com/cslkkl/dsh-cpa-switch/issues"
  },
  "homepage": "https://github.com/cslkkl/dsh-cpa-switch#readme",
  "icon": "./icon.svg",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/",
    "!lib/**/*.map",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README_en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,scss,html,yml,yaml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,scss,html,yml,yaml,md}\"",
    "test": "vitest run",
    "verify:artifacts": "node scripts/verify-artifacts.cjs",
    "check:layering": "node scripts/check-layering.cjs",
    "check:doc-paths": "node scripts/check-doc-paths.cjs",
    "check:release": "node scripts/check-release.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm check:layering && pnpm check:doc-paths && pnpm check:release && pnpm format:check && pnpm build && pnpm verify:artifacts && pnpm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.3",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-credentials": ">=0.2.2-rc.3",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.10.0",
    "react": "^19.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.11"
  }
}
